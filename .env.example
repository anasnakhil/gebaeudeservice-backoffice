# Kopiere diese Datei nach ".env" und ersetze alle Platzhalter.
# Die Datei ".env" gehört NIEMALS ins Repository (steht in .gitignore).

POSTGRES_USER=gs_admin
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort
POSTGRES_DB=gebaeudeservice

# localhost für lokalen Betrieb, auf einem Server deine Domain
DOMAIN=localhost

# Verschlüsselt gespeicherte Zugangsdaten in n8n. Erzeugen z. B. mit:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=bitte-mit-openssl-rand-hex-32-erzeugen

TZ=Europe/Berlin
